# Example local development configuration template
# Copy to application-local.properties (which is gitignored) and customize as needed.

# Local PostgreSQL container settings
DATABASE_URL=jdbc:postgresql://localhost:5432/justdoit
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Local storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage

# AI Provider API Keys (optional for offline testing)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Email service
MAIL_PROVIDER=console
EMAIL_API_KEY=your_email_service_api_key_here

# Show SQL queries in dev console
SHOW_SQL=true
