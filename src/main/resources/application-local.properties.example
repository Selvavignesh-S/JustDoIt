# Example local development configuration template
# Copy to application-local.properties (which is gitignored) and customize as needed.

spring.datasource.url=jdbc:postgresql://localhost:5432/justdoit
spring.datasource.username=postgres
spring.datasource.password=postgres

# Local storage
storage.provider=local
storage.local.base-dir=./storage

# Dev console SQL logging
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# AI Provider API Keys (optional for offline testing)
ai.gemini.api-key=your_gemini_api_key_here
ai.groq.api-key=your_groq_api_key_here

# Email service
mail.provider=console
mail.api-key=your_email_service_api_key_here

# JWT signing secret (required once auth is built). Generate one with: openssl rand -hex 32
security.jwt.secret=replace_with_long_random_hex
