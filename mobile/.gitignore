*.tsbuildinfo

example

# generated native folders
/ios
/android

# Firebase's service-account key (FCM V1) is uploaded to EAS credentials and never committed.
# google-services.json IS committed: it holds only public identifiers (Expo's FCM guide).
*firebase-adminsdk*.json

# Generated by "expo prebuild" (EAS builds generate them in the cloud)
/android
/ios
